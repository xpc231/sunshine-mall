    <dependencies>
        <!-- 框架层依赖 -->
        <dependency>
            <groupId>com.xpcjsu</groupId>
            <artifactId>sunshine-mall-framework-convention</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.xpcjsu</groupId>
            <artifactId>sunshine-mall-framework-database</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.xpcjsu</groupId>
            <artifactId>sunshine-mall-framework-cache</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <dependency>
            <groupId>com.xpcjsu</groupId>
            <artifactId>sunshine-mall-framework-distributedid</artifactId>
            <version>${project.version}</version>
        </dependency>
        
        <!-- RocketMQ -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>